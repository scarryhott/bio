      "status": "OPEN_DATA_ADAPTER_REQUIRED"
    },
    {
      "id": "perturbation-response",
      "return_type": "measured post-intervention expression or phenotype",
      "datasets": ["LINCS L1000", "scPerturb", "public single-cell perturbation benchmarks"],
      "compatible_systems": ["bio-closure-independent", "evo2-7b", "evo2-20b", "evo2-40b"],
      "status": "OPEN_MULTIMODAL_ADAPTER_REQUIRED"
    }
  ],
  "comparison_rules": {
    "same_split": true,
    "same_input_carrier": true,
    "held_out_return_required": true,
    "record_dataset_license": true,
    "record_model_commit_or_revision": true,
    "record_hardware_and_precision": true,
    "separate_native_and_hybrid_arms": true,
    "do_not_score_reported_only_models_as_rerun": true,
    "do_not_treat_language_coherence_as_biological_closure": true
  },
  "verdict": {
    "framework": "CLOSED_FULL_RADICAL_NUMERICS_OPEN_SUITE_COMPARISON_FRAMEWORK",
    "execution": "OPEN_FULL_RADICAL_NUMERICS_BIOLOGICAL_SUITE_RUN",
