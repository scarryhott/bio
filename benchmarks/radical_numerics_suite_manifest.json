      "status": "FRAMEWORK_DEFINED"
    },
    {
      "id": "variant-effect",
      "return_type": "held-out experimental or clinical variant consequence",
      "datasets": ["TraitGym", "BRCA1 DMS", "BRCA2 SGE", "ClinVar", "ProteinGym"],
      "compatible_systems": ["bio-closure-independent", "evo2-7b", "evo2-20b", "evo2-40b", "omnii"],
      "status": "OPEN_DATA_ADAPTER_REQUIRED"
    },
    {
      "id": "gene-completion",
